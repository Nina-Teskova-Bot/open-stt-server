# syntax=docker/dockerfile:1.7
ARG CUDA_BUILDER_IMAGE=nvidia/cuda
ARG CUDA_BUILDER_IMAGE_TAG=12.4.1-devel-ubuntu22.04
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda
ARG CUDA_RUNTIME_IMAGE_TAG=12.4.1-runtime-ubuntu22.04

FROM ${CUDA_BUILDER_IMAGE}:${CUDA_BUILDER_IMAGE_TAG} AS builder

RUN apt-get update && apt-get install -y --no-install-recommends         curl         g++         pkg-config         git         ca-certificates     && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
ENV CARGO_TARGET_DIR=/build/target

COPY Cargo.toml Cargo.lock ./
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked     --mount=type=cache,target=/usr/local/cargo/git,sharing=locked     --mount=type=cache,id=open-stt-server-cuda-target,target=/build/target     mkdir -p src     && echo 'fn main() {}' > src/main.rs     && cargo build --release --features cuda 2>/dev/null || true     && rm -rf src

COPY src ./src
ARG CUDA_COMPUTE_CAP=86
ENV CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP}
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked     --mount=type=cache,target=/usr/local/cargo/git,sharing=locked     --mount=type=cache,id=open-stt-server-cuda-target,target=/build/target     touch src/main.rs     && cargo build --release --features cuda     && cp /build/target/release/open-stt-server /tmp/open-stt-server

FROM ${CUDA_RUNTIME_IMAGE}:${CUDA_RUNTIME_IMAGE_TAG}

RUN apt-get update && apt-get install -y --no-install-recommends         ca-certificates         curl     && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/open-stt-server /usr/local/bin/open-stt-server

VOLUME ["/root/.cache/huggingface"]

ENV OPEN_STT_PORT=8080     OPEN_STT_MODELS=whisper-base     OPEN_STT_DOWNLOAD=true     RUST_LOG=info

EXPOSE 8080

ENTRYPOINT ["open-stt-server"]
