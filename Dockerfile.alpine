# syntax=docker/dockerfile:1.7
ARG RUST_ALPINE_IMAGE=rust
ARG RUST_ALPINE_IMAGE_TAG=alpine
ARG ALPINE_RUNTIME_IMAGE=alpine
ARG ALPINE_RUNTIME_IMAGE_TAG=3.21

FROM ${RUST_ALPINE_IMAGE}:${RUST_ALPINE_IMAGE_TAG} AS builder
WORKDIR /build
ENV CARGO_TARGET_DIR=/build/target

RUN apk add --no-cache         musl-dev         g++         pkgconfig         git         ca-certificates         perl

COPY Cargo.toml Cargo.lock ./
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked     --mount=type=cache,target=/usr/local/cargo/git,sharing=locked     --mount=type=cache,id=open-stt-server-alpine-target,target=/build/target     mkdir -p src     && echo 'fn main() {}' > src/main.rs     && cargo build --release 2>/dev/null || true     && rm -rf src

COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked     --mount=type=cache,target=/usr/local/cargo/git,sharing=locked     --mount=type=cache,id=open-stt-server-alpine-target,target=/build/target     touch src/main.rs     && cargo build --release     && cp /build/target/release/open-stt-server /tmp/open-stt-server

FROM ${ALPINE_RUNTIME_IMAGE}:${ALPINE_RUNTIME_IMAGE_TAG}

RUN apk add --no-cache         ca-certificates         curl         libgcc

COPY --from=builder /tmp/open-stt-server /usr/local/bin/open-stt-server

VOLUME ["/root/.cache/huggingface"]

ENV OPEN_STT_PORT=8080     OPEN_STT_MODELS=whisper-base     OPEN_STT_DOWNLOAD=true     RUST_LOG=info

EXPOSE 8080

ENTRYPOINT ["open-stt-server"]
