# syntax=docker/dockerfile:1.7
ARG RUST_DEV_IMAGE=registry.hnrglobal.com/haydonryan/rust-dev-image
ARG RUST_DEV_IMAGE_TAG=latest

FROM ${RUST_DEV_IMAGE}:${RUST_DEV_IMAGE_TAG} AS builder
WORKDIR /build
ENV CARGO_TARGET_DIR=/build/target

RUN if ! command -v g++ >/dev/null || ! command -v pkg-config >/dev/null; then       apt-get update       && apt-get install -y --no-install-recommends g++ pkg-config git ca-certificates       && rm -rf /var/lib/apt/lists/*;     fi

COPY Cargo.toml Cargo.lock ./
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked     --mount=type=cache,target=/usr/local/cargo/git,sharing=locked     --mount=type=cache,id=open-stt-server-debian-target,target=/build/target     mkdir -p src     && echo 'fn main() {}' > src/main.rs     && cargo build --release 2>/dev/null || true     && rm -rf src

COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked     --mount=type=cache,target=/usr/local/cargo/git,sharing=locked     --mount=type=cache,id=open-stt-server-debian-target,target=/build/target     touch src/main.rs     && cargo build --release     && cp /build/target/release/open-stt-server /tmp/open-stt-server

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends         ca-certificates         curl     && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/open-stt-server /usr/local/bin/open-stt-server

VOLUME ["/root/.cache/huggingface"]

ENV OPEN_STT_PORT=8080     OPEN_STT_MODELS=whisper-base     OPEN_STT_DOWNLOAD=true     RUST_LOG=info

EXPOSE 8080

ENTRYPOINT ["open-stt-server"]
